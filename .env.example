# Salin file ini jadi .env lalu sesuaikan nilainya.
#   cp .env.example .env

# --- Aplikasi ---
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5002
SECRET_KEY=ganti-dengan-string-acak-panjang

# --- Database ---
# Kosongkan untuk SQLite (default, enak untuk belajar).
# Contoh PostgreSQL:
# DATABASE_URL=postgresql+psycopg://campusflow:rahasia@localhost:5432/campusflow
DATABASE_URL=

# --- Auth ---
JWT_SECRET_KEY=ganti-dengan-string-acak-panjang-sama-dengan-SECRET-KEY
# Access token berumur pendek supaya kebocorannya cepat tidak berlaku.
# Frontend menukarnya otomatis dengan refresh token.
JWT_EXPIRES_MINUTES=30
# Refresh token berumur panjang supaya user tidak sering login ulang.
# Token ini bisa dicabut, jadi logout benar-benar mengakhiri sesi.
JWT_REFRESH_EXPIRES_DAYS=14

# --- Keamanan ---
# Dipakai endpoint /api/metrics
ADMIN_API_KEY=ganti-dengan-kunci-acak
RATELIMIT_ENABLED=1
RATELIMIT_STORAGE_URI=memory://
CORS_ORIGINS=http://localhost:5002
